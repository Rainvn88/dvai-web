# Biến môi trường cho website DVAI. Nhập các giá trị thật trong trang quản trị Vibe Host,
# không ghi giá trị thật vào file này hay commit lên GitHub.

# Hộp thư nhận lead (nhiều địa chỉ cách nhau bằng dấu phẩy)
LEAD_TO=sales@dvai.vn

# App Entra ID «DVAI Website Mailer» dùng Microsoft Graph để gửi email (xem DEPLOY.md mục 3)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Hộp thư đứng tên gửi. Đang dùng sales@dvai.vn; đổi thành website@dvai.vn nếu thu hẹp quyền (DEPLOY.md mục 3)
MS_SENDER=sales@dvai.vn

# Chỉ nhận form gửi từ các tên miền này
ALLOWED_ORIGINS=https://dvai.vn,https://www.dvai.vn
